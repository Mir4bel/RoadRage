<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Tiny status label at the top -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TRIP IN PROGRESS"
        android:textSize="18sp"
        android:letterSpacing="0.12"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"/>

    <!-- Speed hero band — background color changes with speed -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_speed_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top row: status label + (future: timer) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_speed_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED OK"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="#CCFFFFFF"/>

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tv_trip_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textSize="11sp"
                    android:textColor="#AAFFFFFF"/>

            </LinearLayout>

            <!-- Big speed number -->
            <TextView
                android:id="@+id/tv_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="92sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:lineHeight="80sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:textSize="14sp"
                android:textColor="#CCFFFFFF"
                android:gravity="center"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Speed graph — gets the rest of the screen -->
    <mira.pharaon.adu.ac.ae.roadrage_group5.SpeedGraphView
        android:id="@+id/speed_graph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="18dp"/>

    <!-- Bottom bar: event counter on left, stop button on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Harsh events badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:backgroundTint="@color/md_theme_primary_container">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">



                <TextView
                    android:id="@+id/tv_event_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:paddingLeft="8dp"/>

                <TextView
                    android:paddingHorizontal="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Harsh Events"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnErrorContainer"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <!-- STOP button: circular red -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stop_trip"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:text="END TRIP"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/md_theme_on_primary_container"
            app:cornerRadius="36dp"
            app:elevation="6dp"/>

    </LinearLayout>

</LinearLayout>