<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Header: title + subtitle, centered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROADRAGE"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnBackground"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="3dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drive smarter, not harder."
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>


    </LinearLayout>

    <!-- Separator line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"/>

    <!-- Flex space — button lives here, truly centered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_trip"
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:text="START"
            android:textSize="22sp"
            android:textStyle="bold"
            android:padding="18dp"
            android:textColor="@color/md_theme_on_tertiary"
            android:backgroundTint="@color/md_theme_tertiary"
            android:stateListAnimator="@null"
            app:icon="@drawable/racing_flag_svgrepo_com"
            app:iconGravity="top"
            app:iconSize="108dp"
            app:cornerRadius="98dp"
            app:elevation="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Begin a monitored drive"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingTop="16dp"/>

    </LinearLayout>

    <!-- TIP CARD (visible by default, dismissed per-day) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        android:backgroundTint="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header row: label + tip number + dismiss button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TIP OF THE DAY"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/md_theme_tertiary"/>

                <TextView
                    android:id="@+id/tv_tip_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginEnd="8dp"/>

                <ImageButton
                    android:id="@+id/btn_dismiss_tip"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_close_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Dismiss"/>

            </LinearLayout>

            <!-- Tip text -->
            <TextView
                android:id="@+id/tv_tip_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:lineSpacingMultiplier="1.45"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- STATS CARD — shown when tip dismissed, now includes streak -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp">

            <!-- Avg score + streak -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVG SCORE"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="3dp"/>

                <TextView
                    android:id="@+id/tv_avg_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface"/>

                <!-- Streak shown here -->
                <TextView
                    android:id="@+id/tv_home_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?attr/colorOutlineVariant"
                android:layout_marginHorizontal="16dp"/>

            <!-- Persona + next tier -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERSONA"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="3dp"/>

                <TextView
                    android:id="@+id/tv_persona"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/tv_next_tier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="?attr/colorTertiary"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"/>

</LinearLayout>
