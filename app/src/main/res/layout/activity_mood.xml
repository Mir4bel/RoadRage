<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_mood"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title=""
        app:elevation="0dp"/>

    <!-- Main content: centered between toolbar and wheel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp">

        <!-- "Let's capture your mood today." (colored in Java) -->
        <TextView
            android:id="@+id/tv_mood_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Let's capture your mood today."
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnBackground"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- Big emoji — changes with wheel selection -->
        <TextView
            android:id="@+id/tv_selected_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😊"
            android:textSize="80sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mood Indicator"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="8dp"/>

        <!-- "I'm Feeling Happy" — changes with selection -->
        <TextView
            android:id="@+id/tv_mood_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I'm Feeling Happy"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnBackground"
            android:layout_marginBottom="28dp"/>

        <!-- Confirm button sits between the label and the wheel -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_mood"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:paddingHorizontal="40dp"
            android:text="Save my feeling"
            android:textSize="15sp"
            app:cornerRadius="26dp"/>

    </LinearLayout>

    <!-- Emoji wheel anchored to bottom — only top arc is visible -->
    <mira.pharaon.adu.ac.ae.roadrage_group5.MoodWheelView
        android:id="@+id/mood_wheel"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:paddingBottom="16dp"/>

</LinearLayout>